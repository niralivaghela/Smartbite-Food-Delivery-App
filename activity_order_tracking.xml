<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F4F4">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FC8019"
        app:title="Track Order"
        app:titleTextColor="#FFFFFF"
        app:navigationIconTint="#FFFFFF"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <!-- ══ ORDER STATUS CARD ══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Live badge + title row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Order Status"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"/>

                        <TextView
                            android:id="@+id/tvLiveBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● LIVE"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:background="@drawable/bg_badge_green"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRestaurantName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Restaurant Name"
                        android:textSize="15sp"
                        android:textColor="#FC8019"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvOrderId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Order #000000"
                        android:textSize="12sp"
                        android:textColor="#888888"/>

                    <!-- Current status label -->
                    <TextView
                        android:id="@+id/tvStatusLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Preparing your food 👨‍🍳"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>

                    <TextView
                        android:id="@+id/tvStatusSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Your order is being prepared with love"
                        android:textSize="12sp"
                        android:textColor="#888888"/>

                    <!-- ── Step Tracker ──────────────────────────────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp">

                        <!-- Step 1 -->
                        <LinearLayout android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center">
                            <View android:id="@+id/stepPlaced"
                                android:layout_width="28dp" android:layout_height="28dp"
                                android:background="@drawable/bg_step_circle"
                                android:backgroundTint="#FC8019"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp" android:text="Placed"
                                android:textSize="9sp" android:textColor="#555555" android:gravity="center"/>
                        </LinearLayout>

                        <View android:id="@+id/linePlacedConfirmed"
                            android:layout_width="0dp" android:layout_height="3dp"
                            android:layout_weight="1" android:background="#DDDDDD"/>

                        <!-- Step 2 -->
                        <LinearLayout android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center">
                            <View android:id="@+id/stepConfirmed"
                                android:layout_width="28dp" android:layout_height="28dp"
                                android:background="@drawable/bg_step_circle"
                                android:backgroundTint="#DDDDDD"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp" android:text="Confirmed"
                                android:textSize="9sp" android:textColor="#555555" android:gravity="center"/>
                        </LinearLayout>

                        <View android:id="@+id/lineConfirmedPreparing"
                            android:layout_width="0dp" android:layout_height="3dp"
                            android:layout_weight="1" android:background="#DDDDDD"/>

                        <!-- Step 3 -->
                        <LinearLayout android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center">
                            <View android:id="@+id/stepPreparing"
                                android:layout_width="28dp" android:layout_height="28dp"
                                android:background="@drawable/bg_step_circle"
                                android:backgroundTint="#DDDDDD"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp" android:text="Preparing"
                                android:textSize="9sp" android:textColor="#555555" android:gravity="center"/>
                        </LinearLayout>

                        <View android:id="@+id/linePreparingDelivery"
                            android:layout_width="0dp" android:layout_height="3dp"
                            android:layout_weight="1" android:background="#DDDDDD"/>

                        <!-- Step 4 -->
                        <LinearLayout android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center">
                            <View android:id="@+id/stepDelivery"
                                android:layout_width="28dp" android:layout_height="28dp"
                                android:background="@drawable/bg_step_circle"
                                android:backgroundTint="#DDDDDD"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp" android:text="On Way"
                                android:textSize="9sp" android:textColor="#555555" android:gravity="center"/>
                        </LinearLayout>

                        <View android:id="@+id/lineDeliveryDelivered"
                            android:layout_width="0dp" android:layout_height="3dp"
                            android:layout_weight="1" android:background="#DDDDDD"/>

                        <!-- Step 5 -->
                        <LinearLayout android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center">
                            <View android:id="@+id/stepDelivered"
                                android:layout_width="28dp" android:layout_height="28dp"
                                android:background="@drawable/bg_step_circle"
                                android:backgroundTint="#DDDDDD"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp" android:text="Delivered"
                                android:textSize="9sp" android:textColor="#555555" android:gravity="center"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ ESTIMATED TIME CARD ════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FC8019">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱"
                        android:textSize="32sp"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimated Delivery"
                            android:textSize="12sp"
                            android:textColor="#FFE0C0"/>

                        <TextView
                            android:id="@+id/tvEstTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30 minutes"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛵"
                        android:textSize="36sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ ORDER DETAILS CARD ═════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order Details"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"
                        android:layout_marginBottom="12dp"/>

                    <!-- Items row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🍽 Items"
                            android:textSize="13sp" android:textColor="#888888"/>
                        <TextView android:id="@+id/tvOrderItems"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="13sp" android:textColor="#1A1A1A"
                            android:textStyle="bold" android:maxLines="2"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>

                    <!-- Total row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💰 Total"
                            android:textSize="13sp" android:textColor="#888888"/>
                        <TextView android:id="@+id/tvOrderTotal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textSize="13sp" android:textColor="#1A1A1A"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ DELIVERY AGENT CARD ════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="🛵"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="#FFF3E8"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delivery Agent"
                            android:textSize="11sp"
                            android:textColor="#888888"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rahul Kumar"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"
                            android:layout_marginTop="2dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ 4.8 · 312 deliveries"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Call button -->
                    <TextView
                        android:id="@+id/btnCallAgent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 Call"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/bg_chip_orange"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ BACK TO HOME BUTTON ════════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackHome"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Back to Home"
                android:textColor="#FC8019"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#FC8019"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>