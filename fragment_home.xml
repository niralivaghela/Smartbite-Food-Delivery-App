<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_home.xml  ·  SmartBite UPGRADED
  ══════════════════════════════════════════════════════════════════
  NEW FEATURES vs original:
  • tvLocation line in header  (city pulled from Firestore)
  • rvBanners offer carousel with dot indicators (dot0/dot1/dot2)
  • layoutFlashDeals section with rvFlashDeals (🔥 strip)
  • shimmerNearby ShimmerFrameLayout for loading state
  • nestedScroll ID for parallax listener
  • headerLayout ID for parallax animation target
  ══════════════════════════════════════════════════════════════════
-->
<androidx.core.widget.NestedScrollView
    android:id="@+id/nestedScroll"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="88dp">

        <!-- ══ ORANGE HEADER ══════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="20dp" android:paddingBottom="20dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/greeting_morning"
                        android:textColor="#FFE0C0" android:textSize="13sp"/>

                    <TextView android:id="@+id/tvUserName"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/placeholder_user_name"
                        android:textColor="@color/white"
                        android:textSize="22sp" android:textStyle="bold"/>

                    <!-- NEW: city / location line -->
                    <LinearLayout android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" android:layout_marginTop="2dp">
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvLocation"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:text="Your City"
                            android:textColor="#FFE0C0" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <ImageView android:id="@+id/btnRefresh"
                    android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@android:drawable/ic_popup_sync"
                    android:alpha="0.8" android:layout_marginEnd="10dp" android:padding="6dp"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivProfilePic"
                    android:layout_width="46dp" android:layout_height="46dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:civ_border_width="2dp" app:civ_border_color="#FFFFFF"/>
            </LinearLayout>

            <!-- Search Bar -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="50dp"
                app:cardCornerRadius="12dp" app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="8dp">
                    <TextView android:layout_width="20dp" android:layout_height="20dp"
                        android:text="🔍" android:textSize="14sp" android:gravity="center"
                        android:layout_marginEnd="8dp"/>
                    <AutoCompleteTextView android:id="@+id/searchView"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="@string/hint_search_restaurants"
                        android:textSize="14sp" android:textColor="#222222"
                        android:textColorHint="#AAAAAA"
                        android:background="@android:color/transparent"
                        android:completionThreshold="1"
                        android:imeOptions="actionSearch" android:inputType="text"
                        android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ══ FOOD CATEGORY ICONS ════════════════════════════════ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingTop="16dp" android:paddingBottom="16dp">
            <HorizontalScrollView android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none" android:paddingStart="12dp">
                <LinearLayout android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal">

                    <!-- Pizza -->
                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:layout_marginEnd="4dp">
                        <androidx.cardview.widget.CardView android:layout_width="56dp" android:layout_height="56dp"
                            app:cardCornerRadius="28dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF3E8">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:text="🍕" android:textSize="26sp" android:gravity="center"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pizza" android:textSize="11sp"
                            android:textColor="@color/text_primary" android:layout_marginTop="5dp"/>
                    </LinearLayout>

                    <!-- Burger -->
                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:layout_marginEnd="4dp">
                        <androidx.cardview.widget.CardView android:layout_width="56dp" android:layout_height="56dp"
                            app:cardCornerRadius="28dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF3E8">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:text="🍔" android:textSize="26sp" android:gravity="center"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Burger" android:textSize="11sp"
                            android:textColor="@color/text_primary" android:layout_marginTop="5dp"/>
                    </LinearLayout>

                    <!-- Biryani -->
                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:layout_marginEnd="4dp">
                        <androidx.cardview.widget.CardView android:layout_width="56dp" android:layout_height="56dp"
                            app:cardCornerRadius="28dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF3E8">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:text="🍛" android:textSize="26sp" android:gravity="center"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Biryani" android:textSize="11sp"
                            android:textColor="@color/text_primary" android:layout_marginTop="5dp"/>
                    </LinearLayout>

                    <!-- Chinese -->
                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:layout_marginEnd="4dp">
                        <androidx.cardview.widget.CardView android:layout_width="56dp" android:layout_height="56dp"
                            app:cardCornerRadius="28dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF3E8">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:text="🍜" android:textSize="26sp" android:gravity="center"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Chinese" android:textSize="11sp"
                            android:textColor="@color/text_primary" android:layout_marginTop="5dp"/>
                    </LinearLayout>

                    <!-- Dessert -->
                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:layout_marginEnd="4dp">
                        <androidx.cardview.widget.CardView android:layout_width="56dp" android:layout_height="56dp"
                            app:cardCornerRadius="28dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF3E8">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:text="🍦" android:textSize="26sp" android:gravity="center"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Dessert" android:textSize="11sp"
                            android:textColor="@color/text_primary" android:layout_marginTop="5dp"/>
                    </LinearLayout>

                    <!-- Drinks -->
                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:layout_marginEnd="16dp">
                        <androidx.cardview.widget.CardView android:layout_width="56dp" android:layout_height="56dp"
                            app:cardCornerRadius="28dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF3E8">
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:text="☕" android:textSize="26sp" android:gravity="center"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Drinks" android:textSize="11sp"
                            android:textColor="@color/text_primary" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ══ OFFER BANNER CAROUSEL (NEW) ════════════════════════ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBanners"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:overScrollMode="never"/>

        <!-- Dot indicators -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal" android:layout_marginTop="8dp"
            android:gravity="center">
            <View android:id="@+id/dot0"
                android:layout_width="8dp" android:layout_height="8dp"
                android:background="@color/primary" android:layout_marginEnd="5dp"/>
            <View android:id="@+id/dot1"
                android:layout_width="8dp" android:layout_height="8dp"
                android:background="@color/divider" android:layout_marginEnd="5dp"/>
            <View android:id="@+id/dot2"
                android:layout_width="8dp" android:layout_height="8dp"
                android:background="@color/divider"/>
        </LinearLayout>

        <!-- ══ CATEGORY FILTER CHIPS ══════════════════════════════ -->
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingTop="16dp" android:paddingBottom="8dp" android:paddingStart="12dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/chipAll"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="🍽 All" android:textColor="@color/white"
                    android:background="@drawable/bg_chip_active"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:gravity="center" android:textSize="12sp" android:layout_marginEnd="8dp"/>

                <TextView android:id="@+id/chipPizza"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="🍕 Pizza" android:textColor="@color/text_primary"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:gravity="center" android:textSize="12sp" android:layout_marginEnd="8dp"/>

                <TextView android:id="@+id/chipBurger"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="🍔 Burger" android:textColor="@color/text_primary"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:gravity="center" android:textSize="12sp" android:layout_marginEnd="8dp"/>

                <TextView android:id="@+id/chipBiryani"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="🍛 Biryani" android:textColor="@color/text_primary"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:gravity="center" android:textSize="12sp" android:layout_marginEnd="8dp"/>

                <TextView android:id="@+id/chipChinese"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="🍜 Chinese" android:textColor="@color/text_primary"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:gravity="center" android:textSize="12sp" android:layout_marginEnd="8dp"/>

                <TextView android:id="@+id/chipSouthIndian"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="🥘 South Indian" android:textColor="@color/text_primary"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:gravity="center" android:textSize="12sp" android:layout_marginEnd="8dp"/>

                <TextView android:id="@+id/chipDessert"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="🍦 Dessert" android:textColor="@color/text_primary"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:gravity="center" android:textSize="12sp" android:layout_marginEnd="8dp"/>

                <TextView android:id="@+id/chipDrinks"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="☕ Drinks" android:textColor="@color/text_primary"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:gravity="center" android:textSize="12sp" android:layout_marginEnd="16dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ══ FLASH DEALS (NEW) ═══════════════════════════════════ -->
        <LinearLayout android:id="@+id/layoutFlashDeals"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="16dp" android:paddingBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔥 Flash Deals" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/text_primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ends soon →" android:textSize="12sp"
                    android:textColor="@color/primary" android:textStyle="bold"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFlashDeals"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>

        <!-- ══ ALL RESTAURANTS HEADER ═══════════════════════════════ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp"
            android:paddingTop="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/chip_all"
                android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/text_primary"/>
            <TextView android:id="@+id/tvRestaurantCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>

        <!-- Shimmer (NEW) for restaurant loading -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerNearby"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:shimmer_duration="1000"
            android:paddingHorizontal="16dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <include layout="@layout/item_shimmer_restaurant"/>
                <include layout="@layout/item_shimmer_restaurant"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- ══ MAIN RESTAURANT LIST ════════════════════════════════ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNearbyRestaurants"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="4dp"
            android:clipToPadding="false" android:nestedScrollingEnabled="false"/>

        <!-- ══ TOP RATED SECTION ═══════════════════════════════════ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="20dp" android:paddingBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Top Rated Near You"
                android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/text_primary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/retry"
                android:textColor="@color/primary" android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTopRated"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="8dp"
            android:clipToPadding="false" android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
